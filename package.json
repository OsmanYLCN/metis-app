{
  "name": "personal-os",
  "version": "0.12.0",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @personal-os/desktop",
    "desktop": "node scripts/desktop.mjs dev",
    "build": "npm run build --workspace @personal-os/desktop",
    "build:desktop": "node scripts/desktop.mjs build",
    "build:api": "dotnet build services/api/PersonalOS.Api.csproj --configuration Release",
    "dev:api": "node scripts/dev-api.mjs",
    "test": "npm run test --workspace @personal-os/desktop",
    "test:api": "node --test scripts/api-smoke.test.mjs",
    "test:ui": "playwright test",
    "test:login-ui": "playwright test --config playwright.login.config.ts",
    "test:native": "node scripts/native-smoke.mjs",
    "test:storage": "cargo test --release --locked --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:identity": "dotnet run --project tests/api/PersonalOS.Api.Tests.csproj --configuration Release",
    "test:tasks-schema": "node --test scripts/tasks-schema.test.mjs",
    "test:postgres": "dotnet build PersonalOS.slnx --configuration Release --no-restore -m:1 && node scripts/test-postgres-adapter.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@playwright/test": "^1.64.1"
  }
}
